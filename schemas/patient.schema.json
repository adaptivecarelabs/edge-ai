{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edge-ai.adaptivecarelabs.com/schemas/patient.schema.json",
  "title": "Patient",
  "description": "Patient identity/demographic record. The primary key is a system-generated UUID, not an external ID (NIN/biometric), since those are not universally available in the MVP deployment context. match_key is used only to surface probable duplicates for CHW review - it is never used to silently merge records.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "System-generated primary key, assigned at first registration and never reassigned."
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "match_key": {
      "type": "object",
      "description": "Normalized fields used for probable-duplicate detection on registration and on sync. Not an identifier - never used for automatic merging.",
      "properties": {
        "name_normalized": {
          "type": "string",
          "description": "Lowercased, whitespace-collapsed given+family name."
        },
        "date_of_birth": { "type": ["string", "null"], "format": "date" },
        "sex": { "type": "string", "enum": ["male", "female", "unknown"] },
        "phone_normalized": { "type": ["string", "null"] }
      },
      "required": ["name_normalized", "sex"],
      "additionalProperties": false
    },
    "duplicate_review": {
      "type": "object",
      "description": "Tracks the manual confirm-or-merge workflow triggered when match_key collides with an existing patient.",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["none", "pending_review", "reviewed_distinct", "reviewed_merged"],
          "default": "none"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidate_patient_id": { "type": "string", "format": "uuid" },
              "match_score": { "type": "number", "minimum": 0, "maximum": 1 },
              "detected_at": { "type": "string", "format": "date-time" },
              "reviewed_by": { "type": ["string", "null"] },
              "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
              "decision": {
                "type": ["string", "null"],
                "enum": [null, "distinct", "merged_into_existing", "merged_into_this"]
              },
              "notes": { "type": ["string", "null"] }
            },
            "required": ["candidate_patient_id", "match_score", "detected_at"],
            "additionalProperties": false
          }
        }
      },
      "required": ["status", "candidates"],
      "additionalProperties": false
    },
    "demographics": {
      "type": "object",
      "properties": {
        "given_name": { "type": "string" },
        "family_name": { "type": "string" },
        "date_of_birth": { "type": ["string", "null"], "format": "date" },
        "date_of_birth_approximate": {
          "type": "boolean",
          "description": "True when DOB is estimated (common where birth records are unavailable)."
        },
        "sex": { "type": "string", "enum": ["male", "female", "unknown"] },
        "phone": { "type": ["string", "null"] },
        "guardian_name": { "type": ["string", "null"] },
        "guardian_phone": { "type": ["string", "null"] },
        "guardian_relationship": { "type": ["string", "null"] }
      },
      "required": ["given_name", "family_name", "sex", "date_of_birth_approximate"],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "description": "Distinguishes manually entered data from OCR-extracted data per system_prompt.md OCR rules - OCR output is never authoritative until CHW-reviewed.",
      "properties": {
        "source": { "type": "string", "enum": ["manual_entry", "ocr_extracted"] },
        "ocr_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "reviewed_by_chw": { "type": "boolean" },
        "source_document_deleted": {
          "type": "boolean",
          "description": "Whether the source image was deleted post-extraction per consent settings."
        }
      },
      "required": ["source", "reviewed_by_chw"],
      "additionalProperties": false
    },
    "registration": {
      "type": "object",
      "properties": {
        "facility_id": { "type": "string" },
        "lga_id": { "type": "string" },
        "registered_by_chw_id": { "type": "string" },
        "registered_at": { "type": "string", "format": "date-time" }
      },
      "required": ["facility_id", "lga_id", "registered_by_chw_id", "registered_at"],
      "additionalProperties": false
    },
    "consent_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Reference to the consent record covering this patient's document scan/data use, if applicable."
    },
    "deleted": {
      "type": "boolean",
      "description": "Soft-delete flag for patient-initiated correction/deletion requests (NDPR).",
      "default": false
    },
    "audit": {
      "type": "object",
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "created_by": { "type": "string" },
        "updated_at": { "type": "string", "format": "date-time" },
        "updated_by": { "type": "string" }
      },
      "required": ["created_at", "created_by", "updated_at", "updated_by"],
      "additionalProperties": false
    }
  },
  "required": ["id", "schema_version", "match_key", "demographics", "provenance", "registration", "audit"],
  "additionalProperties": false
}
